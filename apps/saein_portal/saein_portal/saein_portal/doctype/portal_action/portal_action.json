{
  "doctype": "DocType",
  "name": "Portal Action",
  "module": "Saein Portal",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:ACT-{#####}",
  "track_changes": 1,
  "field_order": [
    "title",
    "domain",
    "responsible",
    "priority",
    "start_date",
    "due_date",
    "status",
    "progress",
    "obstacle",
    "result",
    "evidence",
    "is_demo",
    "schedule_key"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "عنوان",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "domain",
      "label": "حوزه",
      "fieldtype": "Link",
      "options": "Portal Domain",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "responsible",
      "label": "مسئول",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "priority",
      "label": "اولویت",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "default": "Normal",
      "reqd": 1
    },
    {
      "fieldname": "start_date",
      "label": "تاریخ شروع",
      "fieldtype": "Date"
    },
    {
      "fieldname": "due_date",
      "label": "موعد",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "وضعیت",
      "fieldtype": "Select",
      "options": "Open\nIn Progress\nBlocked\nCompleted\nCancelled",
      "default": "Open",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "progress",
      "label": "پیشرفت",
      "fieldtype": "Percent",
      "default": "0"
    },
    {
      "fieldname": "obstacle",
      "label": "مانع",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "result",
      "label": "نتیجه",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "evidence",
      "label": "مدرک انجام",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "is_demo",
      "label": "داده آزمایشی",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "schedule_key",
      "label": "کلید برنامه",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Portal Administrator",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Company Director",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 0,
      "write": 0,
      "delete": 0
    },
    {
      "role": "Domain Officer",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Portal Contributor",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}