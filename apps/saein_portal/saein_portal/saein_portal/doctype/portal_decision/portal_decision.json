{
  "doctype": "DocType",
  "name": "Portal Decision",
  "module": "Saein Portal",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:DEC-{#####}",
  "track_changes": 1,
  "field_order": [
    "domain",
    "title",
    "request",
    "due_date",
    "status",
    "response",
    "responded_by",
    "responded_at",
    "is_demo"
  ],
  "fields": [
    {
      "fieldname": "domain",
      "label": "حوزه",
      "fieldtype": "Link",
      "options": "Portal Domain",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "title",
      "label": "موضوع تصمیم",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "request",
      "label": "شرح درخواست",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "due_date",
      "label": "موعد",
      "fieldtype": "Date"
    },
    {
      "fieldname": "status",
      "label": "وضعیت",
      "fieldtype": "Select",
      "options": "Open\nAnswered",
      "default": "Open"
    },
    {
      "fieldname": "response",
      "label": "پاسخ مدیریت",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "responded_by",
      "label": "پاسخ‌دهنده",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "responded_at",
      "label": "زمان پاسخ",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "is_demo",
      "label": "آزمایشی",
      "fieldtype": "Check"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Portal Administrator",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Company Director",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Domain Officer",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    },
    {
      "role": "Portal Contributor",
      "read": 1,
      "select": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
